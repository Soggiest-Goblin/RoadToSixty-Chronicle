package-as: RoadToSixty-Together

# The repo holds two addons, and each must sit at the top of the zip.
move-folders:
  RoadToSixty-Together/RoadToSixtyTogether: RoadToSixtyTogether
  RoadToSixty-Together/RoadToSixty_Chronicle: RoadToSixty_Chronicle

ignore:
  - docs
  - scripts
  - tests
  - README.md
